        "segments": [
          {
            "id": "T0801_01_seg0001",
            "lb": "T17p0745a01",
            "juan": 1,
            "content": "No. 801",
            "originalContent": "<p>No. 801</p>"
          },
          {
            "id": "T0801_01_seg0002",
            "lb": "T17p0745a02",
            "juan": 1,
            "content": "佛說無常經",
            "originalContent": "<p><b>佛說無常經</b></p>"
          },
          {
            "id": "T0801_01_seg0003",
            "lb": "T17p0745a03",
            "juan": 1,
            "content": "大唐三藏法師義淨譯",
            "originalContent": "<p>大唐三藏法師義淨譯</p>"
          },
          {
            "id": "T0801_01_seg0004",
            "lb": "T17p0745a04",
            "juan": 1,
            "content": "稽首歸依常住照世間，大悲愍物仙，能開甘露門，善趣勝路。",
            "originalContent": "<p>稽首歸依常住照世間，大悲愍物仙，能開甘露門，善趣勝路。</p>",
            "isVerse": true
          },
          {
            "id": "T0801_01_seg0005",
            "lb": "T17p0745a06",
            "juan": 1,
            "content": "世間所有法，皆悉歸無常，少壯同衰老，無能免此患。",
            "originalContent": "<p>世間所有法，皆悉歸無常，少壯同衰老，無能免此患。</p>",
            "isVerse": true
          },
          {
            "id": "T0801_01_seg0006",
            "lb": "T17p0745a08",
            "juan": 1,
            "content": "如是生滅法，暫過如電光，生者皆歸死，壽命安可常？",
            "originalContent": "<p>如是生滅法，暫過如電光，生者皆歸死，壽命安可常？</p>",
            "isVerse": true
          },
          {
            "id": "T0801_01_seg0007",
            "lb": "T17p0745a10",
            "juan": 1,
            "content": "如是四大身，無常不堅固，四大互相違，體若毒蛇篋。",
            "originalContent": "<p>如是四大身，無常不堅固，四大互相違，體若毒蛇篋。</p>",
            "isVerse": true
          },
          {
            "id": "T0801_01_seg0008",
            "lb": "T17p0745a12",
            "juan": 1,
            "content": "爾時世尊告諸苾芻：有三種法，於諸世間是不可愛、是不光澤、是不不可意。何等為三？謂老、病、死。",
            "originalContent": "<p>爾時世尊告諸苾芻：有三種法，於諸世間是不可愛、是不光澤、是不不可意。何等為三？謂老、病、死。</p>"
          },
          {
            "id": "T0801_01_seg0009",
            "lb": "T17p0745a15",
            "juan": 1,
            "content": "世尊復告諸苾芻：若老病死不上世間，如來應正等覺不出於世，為諸眾生說所證法。",
            "originalContent": "<p>世尊復告諸苾芻：若老病死不上世間，如來應正等覺不出於世，為諸眾生說所證法。</p>"
          },
          {
            "id": "T0801_01_seg0010",
            "lb": "T17p0745a18",
            "juan": 1,
            "content": "是故苾芻！當知老病死法，極不可愛，極不光澤，極不可意。應當修習聖道，斷老病死，永離諸苦。",
            "originalContent": "<p>是故苾芻！當知老病死法，極不可愛，極不光澤，極不可意。應當修習聖道，斷老病死，永離諸苦。</p>"
          },
          {
            "id": "T0801_01_seg0011",
            "lb": "T17p0745a21",
            "juan": 1,
            "content": "佛說此經已，諸苾芻眾，歡喜奉行。",
            "originalContent": "<p>佛說此經已，諸苾芻眾，歡喜奉行。</p>"
          }
        ]
      }
    ]
  },
  "rawToc": [
    {
      "title": "佛說無常經",
      "juan": 1
    }
  ]
}
